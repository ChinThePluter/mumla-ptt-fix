<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad "radio" UI (phase 1: TALK/status). Tuned for a ~320x240 no-touch screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1416"
    android:padding="10dp">

    <TextView
        android:id="@+id/radio_server"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#7FB0C0"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/radio_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#E6F0F2"
        android:textSize="24sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#26343A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/radio_label_channel"
        android:textAllCaps="true"
        android:textColor="#6C7B82"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/radio_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#E6F0F2"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/radio_label_talking"
        android:textAllCaps="true"
        android:textColor="#6C7B82"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/radio_talking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#5FD08A"
        android:textSize="18sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/radio_ptt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFB454"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>
