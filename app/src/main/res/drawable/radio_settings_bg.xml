<?xml version="1.0" encoding="utf-8"?>
<!-- Focusable-row background for the keypad radio UI: green outline when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22303A" />
            <stroke android:width="2dp" android:color="#5FD08A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22303A" />
            <stroke android:width="2dp" android:color="#5FD08A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161C20" />
            <stroke android:width="1dp" android:color="#2A3A42" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
