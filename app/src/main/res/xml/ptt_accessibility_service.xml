<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Configuration for MumlaPTTAccessibilityService.
  ~
  ~ The two attributes that matter for background PTT are:
  ~   android:canRequestFilterKeyEvents="true"           (permission to filter keys)
  ~   android:accessibilityFlags="flagRequestFilterKeyEvents"  (actually request them)
  ~
  ~ We do not need accessibility *events* at all, only raw key events, so the
  ~ event mask is kept minimal.
  -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="0"
    android:description="@string/pttAccessibilityDescription" />
